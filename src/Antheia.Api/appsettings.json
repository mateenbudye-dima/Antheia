{
  
  "AllowedOrigins": [
    "http://localhost:5173"
  ],
  "ConnectionStrings": {
    "DefaultConnection": "Server=dima22,1433;Database=Condor_Phase2_Sprint1.1;User Id=AtlasUser;Password=12345678;TrustServerCertificate=True;",
    "AntheiaConnection": "Server=dima22,1433;Database=Antheia;User Id=AtlasUser;Password=12345678;TrustServerCertificate=True;"
    // "tcp:192.168.0.112,1433" use this server name if dima22 is failing to connect
