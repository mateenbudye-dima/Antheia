<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Package Metadata for NuGet -->
    <PackageId>Dima.WorkflowAuditing</PackageId>
    <Version>1.0.0</Version>
    <Authors>Mateen</Authors>
    <Company>Dima</Company>
    <Description>Reusable .NET 10 Workflow Auditing &amp; Approval Middleware with SQL Server auto-migration.</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0-*" />
  </ItemGroup>

</Project>
